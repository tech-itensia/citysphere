{
  "name": "scaas-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Smart City as a Service - ThingsBoard + Kafka + Node.js microservices",
  "workspaces": ["packages/*", "services/*", "tools/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"services/**/test/*.test.ts\" \"tools/**/test/*.test.ts\"",
    "simulate": "npm run start -w tools/simulator"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
