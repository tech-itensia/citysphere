# Copy to .env and adjust. Defaults work for local development on one machine.

# Host ports for the platform APIs (change if something else on your machine uses them)
INGEST_PORT=8091
GATEWAY_PORT=8088

# ThingsBoard image tag for all tb-* microservices (pin a version for repeatable builds, e.g. 4.2.1)
TB_VERSION=latest
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org
TB_SYSADMIN_PASSWORD=sysadmin

# Shared secret for service-to-service calls (the gateway adds it; services reject requests without it)
INTERNAL_TOKEN=dev-internal-token-change-me
# Encrypts ThingsBoard tenant-admin passwords at rest (use a KMS/Vault key in production)
SECRET_KEY=dev-secret-key-change-me

# Demo tenants + simulator API keys (tenant-service seeds them when SEED_DEMO=true)
SEED_DEMO=true
DEMO_API_KEY_DELHI=sk_delhi_demo_0000000000000000000001
DEMO_API_KEY_BENGALURU=sk_bengaluru_demo_000000000000000000001

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Accept "Bearer dev:<user>:<tenant>:<roles>" at the gateway for curl testing. NEVER enable in production.
ALLOW_DEV_TOKENS=true

# Connectors
WEATHER_PROVIDER=open-meteo
EVENTS_PROVIDER=demo
# TRAFFIC_FEED_URL=https://example.org/traffic/{tenant}.json

# Simulator
SIM_INTERVAL_SEC=10
SIM_INCIDENT_EVERY_MIN=3

# React web app (command centre + persona dashboards)
WEB_PORT=5173

# v2: where the resolution SLA clock stops ("closed" per the plan's state machine, or "resolved")
SLA_RESOLUTION_STOP=closed
# Host/URL shown to installers in the device onboarding wizard (MQTT/HTTP to ThingsBoard, ingest API)
TB_PUBLIC_HOST=localhost
INGEST_PUBLIC_URL=http://localhost:8091
