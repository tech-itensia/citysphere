# Shared settings for ThingsBoard core and rule-engine nodes (microservices mode, Kafka queue).
ZOOKEEPER_ENABLED=true
ZOOKEEPER_URL=zookeeper:2181
TB_QUEUE_TYPE=kafka
TB_KAFKA_SERVERS=kafka:9092
TB_QUEUE_KAFKA_REPLICATION_FACTOR=1
JS_EVALUATOR=remote
TRANSPORT_TYPE=remote
HTTP_LOG_CONTROLLER_ERROR_STACK_TRACE=false
CACHE_TYPE=redis
REDIS_HOST=redis
DATABASE_TS_TYPE=sql
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/thingsboard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JAVA_OPTS=-Xms512m -Xmx1536m
