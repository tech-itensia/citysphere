{
  "realm": "scaas",
  "enabled": true,
  "displayName": "Smart City Operating System",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Platform Super Admin - manages all city tenants"
      },
      {
        "name": "city_admin",
        "description": "City Admin - users, zones, SLA policies, integrations"
      },
      {
        "name": "leadership",
        "description": "Leadership / Mayor - read-only city overview"
      },
      {
        "name": "operator",
        "description": "Command Centre Operator - live operations, incidents"
      },
      {
        "name": "dept_head",
        "description": "Department Head - department assets, incidents, SLA"
      },
      {
        "name": "field_tech",
        "description": "Field Technician - assigned work orders"
      },
      {
        "name": "analyst",
        "description": "Analyst - reports and trends"
      },
      {
        "name": "it_ops",
        "description": "IT / Platform Ops - system health, ingestion, DLQ"
      },
      {
        "name": "citizen",
        "description": "Citizen - report and track issues"
      }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "path": "/tenants",
      "subGroups": [
        {
          "name": "delhi",
          "path": "/tenants/delhi",
          "subGroups": [
            {
              "name": "departments",
              "path": "/tenants/delhi/departments",
              "subGroups": [
                {
                  "name": "water",
                  "path": "/tenants/delhi/departments/water",
                  "subGroups": []
                },
                {
                  "name": "electricity",
                  "path": "/tenants/delhi/departments/electricity",
                  "subGroups": []
                },
