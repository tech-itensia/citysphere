                  "subGroups": []
                },
                {
                  "name": "lighting",
                  "path": "/tenants/delhi/departments/lighting",
                  "subGroups": []
                },
                {
                  "name": "waste",
                  "path": "/tenants/delhi/departments/waste",
                  "subGroups": []
                },
                {
                  "name": "environment",
                  "path": "/tenants/delhi/departments/environment",
                  "subGroups": []
                }
              ]
            }
          ]
        },
        {
          "name": "bengaluru",
          "path": "/tenants/bengaluru",
          "subGroups": [
            {
              "name": "departments",
              "path": "/tenants/bengaluru/departments",
              "subGroups": [
                {
                  "name": "water",
                  "path": "/tenants/bengaluru/departments/water",
                  "subGroups": []
                },
                {
                  "name": "electricity",
                  "path": "/tenants/bengaluru/departments/electricity",
                  "subGroups": []
                },
                {
                  "name": "traffic",
                  "path": "/tenants/bengaluru/departments/traffic",
                  "subGroups": []
                },
                {
                  "name": "lighting",
                  "path": "/tenants/bengaluru/departments/lighting",
                  "subGroups": []
                },
                {
                  "name": "waste",
                  "path": "/tenants/bengaluru/departments/waste",
                  "subGroups": []
                },
                {
                  "name": "environment",
                  "path": "/tenants/bengaluru/departments/environment",
                  "subGroups": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "scaas-web",
      "name": "SCaaS Web App",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8088/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8088/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
